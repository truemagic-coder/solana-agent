# Public SDK hosted API defaults.
# Copy to .env and fill in values used by your examples or CLI wrapper.

SOLANA_AGENT_BASE_URL=https://ai.solana-agent.com/v1
SOLANA_AGENT_API_KEY=x402
SOLANA_AGENT_MODEL=memory
SOLANA_AGENT_STATELESS_MODEL=solana-agent-chat
SOLANA_AGENT_INSTRUCTIONS=You are a helpful Solana AI assistant.

# Hosted Privy identity. Create this with `solana-agent wallet menu`.
PRIVY_USER_ID=

# Optional hosted wallet helpers and Solana RPC settings.
X402_PREFERRED_ASSET=USDC
X402_RPC_URL=
SOLANA_RPC_URL=

# Optional MCP tool example settings.
MCP_SERVER_URL=
MCP_SERVER_TOKEN=
OPENAI_API_KEY=
MCP_LLM_MODEL=gpt-4.1-mini

# Optional observability and request sizing.
LOGFIRE_API_KEY=
SOLANA_AGENT_MAX_OUTPUT_TOKENS=4096
SOLANA_AGENT_CONTEXT_WINDOW_TOKENS=128000